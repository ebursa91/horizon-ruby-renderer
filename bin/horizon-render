#!/usr/bin/env ruby
# frozen_string_literal: true

require 'fileutils'
require 'json'
require 'optparse'
require_relative '../lib/horizon_fixture/runtime'

options = { page: 'index', scope: 'page', mode: 'direct' }
OptionParser.new do |parser|
  parser.banner = 'Usage: horizon-render --liquid-root PATH --theme-root PATH --fixture PATH [--scope hero|template|page] [--mode direct|fiber] [--output-dir PATH]'
  parser.on('--liquid-root PATH') { |value| options[:liquid_root] = value }
  parser.on('--theme-root PATH') { |value| options[:theme_root] = value }
  parser.on('--theme PATH') { |value| options[:theme_root] = value }
  parser.on('--fixture PATH') { |value| options[:fixture] = value }
  parser.on('--store PATH') { |value| options[:fixture] = value }
  parser.on('--page NAME') { |value| options[:page] = value }
  parser.on('--scope SCOPE') { |value| options[:scope] = value }
  parser.on('--only TYPE') { |value| options[:scope] = value }
  parser.on('--mode MODE') { |value| options[:mode] = value }
  parser.on('--output-dir PATH') { |value| options[:output_dir] = value }
end.parse!
%i[liquid_root theme_root fixture].each { |key| abort "missing --#{key.to_s.tr('_', '-')}" unless options[key] }

begin
  if options[:output_dir]
    options[:output_dir] = HorizonFixture::Runtime.external_output_path!(options[:output_dir], roots: [options[:liquid_root], options[:theme_root]])
  end
  liquid_source = HorizonFixture::Runtime.load_liquid!(options[:liquid_root])
  HorizonFixture::Runtime.verify_checkout(options[:theme_root], HorizonFixture::THEME_SHA, 'theme')
  fixture = JSON.parse(File.read(options[:fixture]))
  raise ArgumentError, 'fixture theme SHA does not match pin' unless fixture.dig('theme', 'sha') == HorizonFixture::THEME_SHA
  renderer = HorizonFixture::Renderer.new(theme_root: options[:theme_root], fixture: fixture)
  html = HorizonFixture::Runtime.execute(options[:mode]) { renderer.render(page: options[:page], scope: options[:scope]) }
  css = renderer.stylesheets.values.join
  if options[:output_dir]
    manifest = renderer.manifest.merge(
      'scope' => options[:scope], 'fixture_sha256' => Digest::SHA256.file(options[:fixture]).hexdigest,
      'html_sha256' => Digest::SHA256.hexdigest(html), 'liquid_root' => File.realpath(options[:liquid_root]),
      'liquid_sha' => HorizonFixture::LIQUID_SHA, 'liquid_source' => liquid_source,
      'ruby_version' => RUBY_VERSION, 'ruby_description' => RUBY_DESCRIPTION,
      'yjit_enabled' => defined?(RubyVM::YJIT) ? RubyVM::YJIT.enabled? : false,
      'execution_mode' => options[:mode], 'schema_version' => 1,
      'html' => { 'bytes' => html.bytesize, 'sha256' => Digest::SHA256.hexdigest(html) },
      'css' => { 'bytes' => css.bytesize, 'sha256' => Digest::SHA256.hexdigest(css) }
    )
    FileUtils.mkdir_p(options[:output_dir])
    File.write(File.join(options[:output_dir], 'index.html'), html)
    File.write(File.join(options[:output_dir], 'styles.css'), css)
    File.write(File.join(options[:output_dir], 'report.json'), JSON.pretty_generate(manifest) + "\n")
    puts JSON.generate(manifest)
  else
    print html
  end
rescue ArgumentError, LoadError, HorizonFixture::ContractError => error
  warn error.message
  exit 1
end
